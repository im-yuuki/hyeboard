# Copy to .env — sets HYEB_SESSION_SECRET.
# Non-secret defaults live in config.json (checked into repo, no secrets); env
# values override them.
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

HYEB_SESSION_SECRET=

# Optional non-secret overrides; config.json carries the same defaults.
# VNU_CODE_LOOKUP_CONCURRENCY=16
# VNU_CROSS_LOOKUP_BULK_MAX_TARGETS=500
# VNU_CROSS_LOOKUP_DIRECT_CHUNK_MAX_TARGETS=32
# VNU_CODE_LOOKUP_BULK_TARGET_CONCURRENCY=3
# VNU_CROSS_LOOKUP_REQUEST_TIMEOUT_MS=60000
# VNU_CROSS_DETAIL_MAX_TARGETS=50
# VNU_CROSS_DETAIL_MAX_ROWS=200
# VNU_CROSS_DETAIL_CONCURRENCY=6
# VNU_CROSS_DETAIL_BUDGET=300
# VNU_CROSS_DETAIL_WINDOW_SECONDS=600
# VNU_CROSS_DETAIL_PERMIT_TTL_SECONDS=60
# VNU_CROSS_DETAIL_EXPORT_MODE=selected
# Self-hosted HA mode: memory (default), or distributed when both shared
# dependencies below are configured. Cloudflare uses its Worker entry point.
HYEB_HA_MODE=memory
# HYEB_HA_NODE_ID=
# HYEB_HA_SESSION_EPOCH=0
# HYEB_HA_ENFORCE_SESSION_EPOCH=false
# Distributed mode requires one PostgreSQL URL and one Redis URL for ready
# operation. Use HYEB_* names or the DATABASE_URL/REDIS_URL aliases.
# HYEB_POSTGRES_URL=
# HYEB_REDIS_URL=
# DATABASE_URL=
# REDIS_URL=
# HYEB_SHUTDOWN_TIMEOUT_MS=10000
